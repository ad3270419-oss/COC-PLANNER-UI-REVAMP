<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <!-- Optional Section Header (Shown above first Builder row and first Lab/Pet row) -->
    <TextView
        android:id="@+id/widget_item_section_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="2dp"
        android:paddingTop="4dp"
        android:paddingRight="2dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:text="BUILDERS  6/6 + Goblin"
        android:textColor="#F3CA65"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Upgrade Card Container -->
    <LinearLayout
        android:id="@+id/widget_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_item_card_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingTop="9dp"
        android:paddingRight="11dp"
        android:paddingBottom="9dp">

        <!-- Left 3D Game Asset Icon -->
        <ImageView
            android:id="@+id/widget_item_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="10dp"
            android:contentDescription="Upgrade Icon"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <!-- Right Content Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Top Row: Upgrade Title + Target Level (→ 26) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_item_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Royal Champion · G"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_item_target_lvl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="6dp"
                    android:singleLine="true"
                    android:text="→ 26"
                    android:textColor="#F3CA65"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Prominent Real-World Finish Date & Time -->
            <TextView
                android:id="@+id/widget_item_finish_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="Nov 9, 5:57 PM"
                android:textColor="#4ADE80"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/widget_item_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progress="62"
                android:progressDrawable="@drawable/widget_progress_bar" />

            <!-- Bottom Full Finish Timestamp Line -->
            <TextView
                android:id="@+id/widget_item_finish_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Finishes 09/11/2026 5:57 pm"
                android:textColor="#8E9AA8"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
