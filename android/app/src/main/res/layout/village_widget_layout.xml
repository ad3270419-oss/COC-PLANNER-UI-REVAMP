<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingLeft="13dp"
    android:paddingTop="12dp"
    android:paddingRight="13dp"
    android:paddingBottom="10dp">

    <!-- 1. HEADER ROW: 3D Town Hall Icon, Village Name (NO TAG), TH + Builders Subtitle, Account Switch & One-Tap Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_th_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="10dp"
            android:contentDescription="Town Hall"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <LinearLayout
            android:id="@+id/widget_header_title_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Village Name (replaces Player Tag per user request) -->
            <TextView
                android:id="@+id/widget_village_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="DEATH DELEAR"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <!-- TH & Builders Count Subtitle -->
            <TextView
                android:id="@+id/widget_builders_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="TH 17 · 6/6 BUILDERS + G"
                android:textColor="#F3CA65"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Multi-Account Switch Button (Switch accounts without opening the app) -->
        <TextView
            android:id="@+id/widget_btn_switch"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_action_btn_bg"
            android:gravity="center"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:singleLine="true"
            android:text="⇄ 1/1"
            android:textColor="#F3CA65"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- One-Tap Refresh Button -->
        <TextView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/widget_action_btn_bg"
            android:gravity="center"
            android:singleLine="true"
            android:text="↻"
            android:textColor="#F3CA65"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. BOOST STATUS BANNER (Purple-bordered pill matching screenshot) -->
    <LinearLayout
        android:id="@+id/widget_boost_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/widget_boost_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="11dp"
        android:paddingTop="7dp"
        android:paddingRight="11dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/widget_boost_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:text="🕒"
            android:textColor="#F3CA65"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_boost_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="No active boosts"
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. SCROLLABLE UPGRADE CARDS LIST (Builders + Laboratory + Pet House) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="7dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/widget_upgrades_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/widget_upgrades_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_item_card_bg"
            android:gravity="center"
            android:padding="14dp"
            android:text="All Builders, Lab &amp; Pets Idle"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 4. FOOTER BAR: OPEN VILLAGE ↗ & UPDATED TIME -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_tap_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="OPEN VILLAGE  ↗"
            android:textColor="#CBD5E1"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_last_synced"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="right"
            android:singleLine="true"
            android:text="UPDATED --:--"
            android:textColor="#8E9AA8"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
